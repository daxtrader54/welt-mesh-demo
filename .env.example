# Mesh sandbox credentials. Account > Get your API keys in the Mesh dashboard.
# The API key is shown once at generation. The Client ID sits at the top right of the same page.
MESH_CLIENT_ID=
MESH_API_KEY=
MESH_API_BASE_URL=https://sandbox-integration-api.meshconnect.com

# Merchant destination. Fixed for this build.
MERCHANT_ADDRESS=0x0Ff0000f0A0f0000F0F000000000ffFf00f0F0f0
MERCHANT_NETWORK_ID=e3c7fdd8-b1fc-4e51-85ae-bb276e075611

# Optional, and normally left blank.
#
# The checkout already names a provider and deep-links to it. That name comes from
# /api/mesh/providers, which ranks the live catalogue by what can actually settle to this
# address and network, so the button follows the catalogue rather than a value set here.
#
# This is the override for when you want one provider pinned regardless. It is used as the
# server-side fallback if the providers call has not answered yet.
# Coinbase sandbox is 721a5035-029f-4e05-bf3c-009da2fe381b
MESH_COINBASE_INTEGRATION_ID=

# Optional, but required for webhook settlement to work on serverless. Without it the app falls
# back to an in-memory store: fine locally, unreliable on Vercel, because the webhook and the
# browser may not be the same instance.
#
# Adding Upstash through the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN
# instead, and those are accepted too. Set either pair, not both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Account > Get your API keys > Sandbox Transfer Webhook Callback URI.
# Shown once at registration. Without it the webhook route rejects every delivery.
MESH_WEBHOOK_SECRET=

# Merchant handling fee in dollars, sent to Mesh as clientFee. The destination still receives the
# full order amount; this sits on top of it.
#
# Zero by default, deliberately. The mechanism is wired up and tested, but a shop that advertises
# $50 and charges $52 is either showing the fee up front, in which case the headline price is
# wrong, or revealing it at the last step, which is drip pricing and now unlawful in the UK. The
# capability is worth demonstrating; the dark pattern is not. Set it to 2 to see it work.
NEXT_PUBLIC_MERCHANT_HANDLING_FEE=0
